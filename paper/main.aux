\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Acoustic motion descriptors for one anchor and two of its realizations (illustrative; provisional ontology). Left: short-time RMS energy over time; right: spectral centroid (brightness) over time. Transposition (\texttt  {+2st}) preserves the energy shape and raises the brightness curve; the strong tempo change (\texttt  {x0.8}) preserves the shape while changing the duration. This motivates the trajectory view but is not a representation result.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:motion}{{1}{6}{Acoustic motion descriptors for one anchor and two of its realizations (illustrative; provisional ontology). Left: short-time RMS energy over time; right: spectral centroid (brightness) over time. Transposition (\texttt {+2st}) preserves the energy shape and raises the brightness curve; the strong tempo change (\texttt {x0.8}) preserves the shape while changing the duration. This motivates the trajectory view but is not a representation result}{figure.1}{}}
